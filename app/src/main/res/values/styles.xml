<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#335C45</item>
        <item name="android:statusBarColor">#F5F5EE</item>
        <item name="android:navigationBarColor">#F5F5EE</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F5F5EE</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="WidgetLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_accent</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
